# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# JWT Configuration
jwt_secret=your-secret-key-here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AWS Configuration
aws_access_key_id=your-aws-access-key-id
aws_secret_access_key=your-aws-secret-access-key
aws_bucket=your-s3-bucket-name
aws_region=eu-central-1

# S3 Upload Folders
aws_form_upload_folder=forms
aws_gift_upload_folder=gifts

# Database Configuration
conn_string=postgresql://username:password@host:port/database
db_host=localhost
db_port=5432
db_name=your_database
db_user=your_username
db_password=your_password

# Stripe Configuration
secret_key=sk_test_your_stripe_secret_key
endpoint_secret=whsec_your_webhook_endpoint_secret
profit_account_id=acct_your_profit_account_id

# Optional: For local development
# AWS_PROFILE=default
# AWS_DEFAULT_REGION=eu-central-1
